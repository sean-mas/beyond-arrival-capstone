# Copy to .env. Never commit .env; gitleaks runs in pre-commit and in CI.

DATABASE_URL=postgresql+psycopg://companion:companion@localhost:5432/companion

# The model under test. One config field, changed one at a time, so a run is
# attributable to exactly one difference. See docs/evals.md layer 4.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_API_KEY=

# The judge must never be the model under test. docs/evals.md, layer 3.
JUDGE_PROVIDER=groq
JUDGE_MODEL=qwen/qwen3.8-27b

# Pinned. Changing it means rebuilding the store and invalidates every
# retrieval_top_score already logged. See src/companion/config.py.
EMBEDDING_MODEL=bge-m3
RETRIEVAL_K=6

# Tracing. Free tier. docs/constraints.md section 1 lists what must be on every span.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

TELEGRAM_BOT_TOKEN=
PROMPT_VERSION=v0

# ---------------------------------------------------------------------------
# The hosted tiers. Tier 1 is local and free; these two cost money.
#
# Both are off unless the key is set, and a tier with no key REFUSES to run
# rather than falling back to the local model. That is deliberate: a silent
# fallback would publish a hosted number that llama3.1:8b produced.
# ---------------------------------------------------------------------------

# Tier 2, mid-tier hosted. https://ollama.com -> Settings -> Keys
# Same wire protocol as your local daemon, so nothing else changes.
# Set the model to one your account actually lists.
OLLAMA_CLOUD_API_KEY=
# The three hosted tiers. All on Ollama Cloud: the models worth comparing
# elsewhere (kimi-k3, deepseek-v4-pro, glm-5.x, qwen3.5:397b) all return 402
# Payment Required on a free key, checked 24.09.2026.
# Free and usable: gpt-oss:120b, gpt-oss:20b, nemotron-3-ultra,
# nemotron-3-super, nemotron-3-nano:30b, gemma4:31b.
TIER2_MODEL=gpt-oss:120b
TIER3_MODEL=nemotron-3-ultra
TIER4_MODEL=gemma4:31b

# Retired from the tier ladder on 24.09.2026: 81 seconds a call on the free
# tier, about thirty hours for 115 cases. Key kept; run it with
#   make tier3 ARGS='--model <gemini model>'  once billing is on.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Flash-class stays free-tier eligible. gemini-2.5-pro is retired for new
# keys and Pro sits behind billing. Checked 23.09.2026.
GEMINI_MODEL=gemini-3.5-flash-lite

# Tier 5, the one non-Ollama vendor. https://console.mistral.ai/api-keys
# Measured 24.09.2026 on a free key: ~150 seconds per call whatever the model,
# an account-level throttle rather than model latency, and only
# ministral-14b-latest is permitted. mistral-medium, magistral-medium,
# mistral-small and magistral-small all return 429. About thirteen hours for
# 115 cases, so run it across nights with --resume.
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest

# Tier 6, the frontier model. https://platform.deepseek.com/api_keys
# NOT free: checked 24.09.2026, granted_balance 0.00 and both models return
# 402 Insufficient Balance, so the signup token grant did not apply. A full
# 115-case run is ~450k tokens, about twenty cents at V4-Pro rates, so a two
# dollar top-up covers the whole capstone.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# The Render deploy (render.yaml sets these there; listed so .env can mirror them)
GROQ_API_KEY=
HF_TOKEN=
# Workers AI, free tier: the hosted bge-m3 since 15.10.2026
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Neon's External Database URL, for `make ingest-render` from this machine
RENDER_DATABASE_URL=
# Leave unset here. Only render.yaml turns it on, so eval traces never leave this machine
# LANGFUSE_ALLOW_CLOUD=true
