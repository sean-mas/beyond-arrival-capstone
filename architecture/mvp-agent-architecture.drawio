        <mxCell id="e15" edge="1" parent="1" source="t1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1A1A1A;strokeWidth=2;fontSize=12;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0" target="tg" value="the answer, under their brand">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="390" y="773" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e16" edge="1" parent="1" source="t2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D0342C;strokeWidth=2.5;fontSize=12;fontColor=#D0342C;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" target="cons" value="only when a person is needed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" edge="1" parent="1" source="tg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0" target="fam" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;fontSize=12;fontColor=#1A1A1A" value="1." vertex="1">
          <mxGeometry height="30" width="30" x="1352" y="532" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;fontSize=12;fontColor=#1A1A1A" value="2." vertex="1">
          <mxGeometry height="30" width="30" x="1126" y="640" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;fontSize=12;fontColor=#1A1A1A" value="3." vertex="1">
          <mxGeometry height="30" width="30" x="260" y="386" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;fontSize=12;fontColor=#1A1A1A" value="4." vertex="1">
          <mxGeometry height="30" width="30" x="655" y="252" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;fontSize=12;fontColor=#1A1A1A" value="5." vertex="1">
          <mxGeometry height="30" width="30" x="744" y="326" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;fontSize=12;fontColor=#1A1A1A" value="6." vertex="1">
          <mxGeometry height="30" width="30" x="1112" y="428" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;fontSize=12;fontColor=#1A1A1A" value="7." vertex="1">
          <mxGeometry height="30" width="30" x="944" y="552" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;fontSize=12;fontColor=#1A1A1A" value="8." vertex="1">
          <mxGeometry height="30" width="30" x="944" y="662" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="ellipse;html=1;fillColor=#FFFFFF;strokeColor=#7A7A7A;fontSize=12;fontColor=#1A1A1A" value="9." vertex="1">
          <mxGeometry height="30" width="30" x="330" y="700" as="geometry" />
        </mxCell>
        <mxCell id="foot" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#4A4A4A" value="1. The provider hands over material they already have.   2. Chunked and embedded once, into one store.   3. The family taps, or writes.   4. The scheduler nudges even when they do not.   5. The context is assembled.&#xa;6. The agent retrieves from their material.   7. Nothing leaves without passing the out guardrails.   8. Tools do the acting.   9. The answer goes back on Telegram, and a human is paged only when one is needed." vertex="1">
          <mxGeometry height="40" width="1470" x="60" y="940" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Scope options" id="scope">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="st" value="What is in the MVP, what is not, and what you have to decide" style="text;html=1;align=center;fontSize=24;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="250" y="24" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="ch1" value="✅  IN — the MVP needs these" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#1A7A4A" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="250" height="22" as="geometry" />
        </mxCell>
        <mxCell id="i1" value="Telegram, one channel&#xa;free Bot API, no verification, works today" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1A7A4A;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="200" height="62" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="Scheduler / journey spine&#xa;a cron. Works on a family that never replies." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1A7A4A;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="60" y="184" width="200" height="62" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="RAG over their material&#xa;pgvector in the same Postgres" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1A7A4A;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="60" y="258" width="200" height="62" as="geometry" />
        </mxCell>
        <mxCell id="i4" value="Crisis detection + escalation&#xa;safety, not a feature. Non-negotiable." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D0342C;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="60" y="332" width="200" height="62" as="geometry" />
        </mxCell>
        <mxCell id="i5" value="Refusal policy&#xa;no visa, tax, legal, medical" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D0342C;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="60" y="406" width="200" height="62" as="geometry" />
        </mxCell>
        <mxCell id="i6" value="Groundedness gate&#xa;cite a chunk or send it verbatim" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1A7A4A;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="200" height="62" as="geometry" />
        </mxCell>
        <mxCell id="i7" value="tenant_id from day one&#xa;one pilot provider, but retrofitting it is painful" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1A7A4A;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="60" y="554" width="200" height="62" as="geometry" />
        </mxCell>
        <mxCell id="ch2" value="🚫  OUT — and what it costs" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#7A7A7A" vertex="1" parent="1">
          <mxGeometry x="320" y="80" width="250" height="22" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="WhatsApp&#xa;Meta business verification, per-message cost. Costs you: the channel families actually use." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9A9A9A;dashed=1;fontSize=12;fontColor=#4A4A4A" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="230" height="72" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="Web app / dashboard UI&#xa;Costs you: the provider sees nothing. Mitigate with a weekly email digest." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9A9A9A;dashed=1;fontSize=12;fontColor=#4A4A4A" vertex="1" parent="1">
          <mxGeometry x="320" y="194" width="230" height="72" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="A trained router&#xa;Zero-shot classification is enough at pilot volume. Costs you: no MLOps story." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9A9A9A;dashed=1;fontSize=12;fontColor=#4A4A4A" vertex="1" parent="1">
          <mxGeometry x="320" y="278" width="230" height="72" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="Graph DB, memory layers, MCP servers&#xa;Nothing in this product needs them yet. Costs you: nothing. Do not add them." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9A9A9A;dashed=1;fontSize=12;fontColor=#4A4A4A" vertex="1" parent="1">
          <mxGeometry x="320" y="362" width="230" height="72" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="Multi-corridor content&#xa;rt5 is accepted: one corridor for v1. Costs you: only serves one origin country." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9A9A9A;dashed=1;fontSize=12;fontColor=#4A4A4A" vertex="1" parent="1">
          <mxGeometry x="320" y="446" width="230" height="72" as="geometry" />
        </mxCell>
        <mxCell id="o6" value="Fine-tuning, voice, multi-agent&#xa;Costs you: nothing. These are how MVPs die." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9A9A9A;dashed=1;fontSize=12;fontColor=#4A4A4A" vertex="1" parent="1">
          <mxGeometry x="320" y="530" width="230" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ch3" value="❓  DECIDE — three forks, with a recommendation" style="text;html=1;align=left;fontSize=14;fontStyle=1;fontColor=#A34D26" vertex="1" parent="1">
          <mxGeometry x="610" y="80" width="380" height="22" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="LangGraph, LangChain, or neither?&#xa;&#xa;You said LangChain. Honest read: this flow is retrieve → prompt → check → send, which is roughly 200 lines of plain SDK. LangChain&#39;s abstractions also fight the Capstone 2 requirement for a clean typed package with Pydantic.&#xa;&#xa;RECOMMENDATION: LangGraph, not LangChain. You get an explicit state machine, which is genuinely useful for the guardrail branches and escalation, and Langfuse traces it natively. Skip the LangChain chain abstractions." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#FFFFFF;strokeColor=#A34D26;strokeWidth=2;fontSize=12;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="610" y="110" width="380" height="180" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Is it an agent at all?&#xa;&#xa;An agent means the model chooses which tool to call. Most of this product is a scheduler firing content on a date, which needs no agency and no tool choice.&#xa;&#xa;RECOMMENDATION: call it an agent only for the reactive path, where the model does pick between retrieve, escalate and answer. The scheduled path stays a plain pipeline. Drawing both as one agent hides that half the value needs no LLM decision at all." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#FFFFFF;strokeColor=#A34D26;strokeWidth=2;fontSize=12;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="610" y="304" width="380" height="180" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Whose content is in the RAG store?&#xa;&#xa;The diagram shows the provider&#39;s handbooks. But you have no provider, and your own situation cards do not exist either. So on day one the store is empty.&#xa;&#xa;RECOMMENDATION: write 20 cards for one corridor yourself, before any provider says yes. It is the asset rt5 says is the real cost, it is the thing a call can react to, and it is the only version of this that you can build before 15.10." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fillColor=#FFFFFF;strokeColor=#A34D26;strokeWidth=3;fontSize=12;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="610" y="498" width="380" height="196" as="geometry" />
        </mxCell>
        <mxCell id="warn" value="THE THING THIS DIAGRAM QUIETLY ASSUMES&#xa;&#xa;Every box on page 1 is cheap. The expensive part is not on the diagram at all: somebody has to write the situational content, per corridor, in a voice a family in month four will actually read. rt5 is accepted in both ideas for exactly this reason. An MVP that ships all nine numbered steps with an empty knowledge base is a working system that says nothing useful." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;fillColor=#FFFFFF;strokeColor=#D0342C;strokeWidth=2.5;fontSize=12;fontColor=#1A1A1A" vertex="1" parent="1">
          <mxGeometry x="60" y="716" width="930" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 · Capstone 1 deploy" id="deploy1">
    <mxGraphModel dx="1500" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1050" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="t" value="Capstone 1 — deploy: one container, all free" style="text;html=1;align=left;fontSize=24;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="40" y="24" width="800" height="30" as="geometry"/></mxCell>
        <mxCell id="st" value="One image on Render's free tier, Neon for Postgres, hosted models. EUR 0 a month; about a minute to wake after 15 idle minutes. Updated 25.09.2026." style="text;html=1;align=left;fontSize=13;fontColor=#7A7A7A" vertex="1" parent="1"><mxGeometry x="40" y="56" width="900" height="20" as="geometry"/></mxCell>

        <mxCell id="fam" value="The Family&#10;on their phone" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E8873A;strokeWidth=3;fontSize=14;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="40" y="238" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="coach" value="Coach / visitor&#10;the demo audience" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E8873A;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="40" y="430" width="190" height="76" as="geometry"/></mxCell>
        <mxCell id="chg" value="STEP TWO — not in Capstone 1" style="rounded=1;arcSize=6;html=1;fillColor=none;strokeColor=#9A9A9A;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=10;fontColor=#7A7A7A" vertex="1" parent="1"><mxGeometry x="258" y="186" width="184" height="180" as="geometry"/></mxCell><mxCell id="tg" value="Telegram&#10;free" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9A9A9A;dashed=1;fontSize=13;fontColor=#7A7A7A" vertex="1" parent="1"><mxGeometry x="272" y="214" width="156" height="58" as="geometry"/></mxCell><mxCell id="wa" value="WhatsApp&#10;the cost driver" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D0342C;dashed=1;fontSize=13;fontColor=#B32219" vertex="1" parent="1"><mxGeometry x="272" y="288" width="156" height="58" as="geometry"/></mxCell>
        <mxCell id="br" value="Browser" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E6FD9;strokeWidth=2.5;fontSize=14;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="270" y="430" width="160" height="76" as="geometry"/></mxCell>

        <mxCell id="plat" value="ONE REPO, ONE IMAGE  —  Dockerfile  ·  Render free, Frankfurt" style="rounded=1;arcSize=3;html=1;fillColor=none;strokeColor=#1A1A1A;strokeWidth=2.5;dashed=1;dashPattern=8 5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="480" y="140" width="640" height="380" as="geometry"/></mxCell>

        <mxCell id="fe" value="/chat&#10;&#10;the static demo page&#10;served by the same&#10;FastAPI process" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#EAF3FA;strokeColor=#2E6FD9;strokeWidth=3;fontSize=14;fontStyle=1;fontColor=#1A5490" vertex="1" parent="1"><mxGeometry x="500" y="190" width="250" height="150" as="geometry"/></mxCell>
        <mxCell id="fen" value="One origin, so no CORS and&#10;no second deploy. Behind&#10;DEMO_PASSCODE." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#1A7A4A" vertex="1" parent="1"><mxGeometry x="500" y="352" width="250" height="52" as="geometry"/></mxCell>

        <mxCell id="be" value="FastAPI  ·  the API" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FCE8D8;strokeColor=#E8873A;strokeWidth=3;verticalAlign=top;spacingTop=12;fontSize=14;fontStyle=1;fontColor=#B35A18" vertex="1" parent="1"><mxGeometry x="820" y="190" width="290" height="300" as="geometry"/></mxCell>
        <mxCell id="b1" value="/telegram/webhook" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9A9A9A;dashed=1;fontSize=12;fontColor=#7A7A7A" vertex="1" parent="1"><mxGeometry x="838" y="226" width="254" height="42" as="geometry"/></mxCell>
        <mxCell id="b2" value="/api/chat" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1A1A1A;fontSize=12;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="838" y="280" width="254" height="42" as="geometry"/></mxCell>
        <mxCell id="b3" value="the agent · guardrails · retrieval" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E8873A;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="838" y="334" width="254" height="42" as="geometry"/></mxCell>
        <mxCell id="b4" value="/healthz  ·  rate limit 20/h, 150/day" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1A1A1A;fontSize=12;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="838" y="388" width="254" height="42" as="geometry"/></mxCell>

        <mxCell id="pg" value="Postgres + pgvector&#10;chunks, seats, conversation log, eval results" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=2;fontSize=13;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="620" y="560" width="380" height="110" as="geometry"/></mxCell>
        <mxCell id="pgn" value="Outside Render: Neon free tier, Frankfurt. Does not expire, unlike Render's free Postgres." style="text;html=1;align=center;fontSize=11;fontColor=#1A7A4A" vertex="1" parent="1"><mxGeometry x="620" y="682" width="380" height="18" as="geometry"/></mxCell>

        <mxCell id="mdl" value="Hosted models&#10;&#10;answers: Ollama Cloud gpt-oss:120b&#10;crisis check: Groq qwen3.8-27b&#10;search: Cloudflare Workers AI bge-m3" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C2900A;strokeWidth=2.5;fontSize=12;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="1170" y="200" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="lf" value="Langfuse Cloud EU&#10;live traces, free Hobby&#10;evals stay on the laptop" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#0D6A60;strokeWidth=2.5;fontSize=12;fontStyle=1;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="1170" y="380" width="210" height="80" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9A9A9A;dashed=1;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.28;entryDx=0;entryDy=0" edge="1" parent="1" source="fam" target="chg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1A1A1A;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="coach" target="br"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="webhooks, later" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9A9A9A;dashed=1;strokeWidth=1.5;fontSize=11;fontColor=#7A7A7A;labelBackgroundColor=#FFFFFF;verticalAlign=top;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="chg" target="be"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="907" y="174"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.73;entryDx=0;entryDy=0" edge="1" parent="1" source="br" target="fe"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="466" y="468"/><mxPoint x="466" y="300"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="fetch /api/chat&#10;same origin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D0342C;strokeWidth=2.5;fontSize=11;fontColor=#D0342C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.34;entryDx=0;entryDy=0" edge="1" parent="1" source="fe" target="be"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1A1A1A;strokeWidth=1.5;fontSize=11;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.62;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="be" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C2900A;strokeWidth=2;exitX=1;exitY=0.17;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="be" target="mdl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="traces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=11;fontColor=#0D6A60;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.77;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="be" target="lf"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="nb" value="WHY ONE CONTAINER&#10;&#10;The code already serves /chat from FastAPI: one origin, no CORS, one deploy. The frontend and backend split waits for Capstone 2, when there is a real frontend to own separately." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#FFFFFF;strokeColor=#1A7A4A;strokeWidth=2;fontSize=12;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="40" y="812" width="660" height="92" as="geometry"/></mxCell>
        <mxCell id="nc" value="WHAT FREE COSTS&#10;&#10;Sleeps after 15 minutes idle, about a minute to wake: open the link before presenting. The crisis check is a weaker hosted guard (recall 0.622 against 0.865 locally), disclosed in the deck." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#FFFFFF;strokeColor=#D0342C;strokeWidth=2;fontSize=12;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="720" y="812" width="660" height="92" as="geometry"/></mxCell>
        <mxCell id="nd" value="LIVE SETUP, 25.09.2026  ·  EUR 0 a month&#10;&#10;app → Render free, Frankfurt  ·  database → Neon free  ·  models → Ollama Cloud, Groq and Cloudflare Workers AI free tiers  ·  traces → Langfuse Cloud EU, Hobby&#10;No Redis: an in-app rate limit guards the free quotas. Pay for Render Starter (about 7 EUR) the day the link goes to a provider." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#FFFFFF;strokeColor=#1A1A1A;strokeWidth=2;fontSize=12;fontColor=#1A1A1A" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1340" height="96" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

