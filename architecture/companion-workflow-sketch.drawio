        <mxCell id="y1" value="Local, via Ollama&#10;free, so iterate as much as you like" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;sketch=1;curveFitting=1;jiggle=2;fillStyle=solid;fillColor=#FEFAE4;strokeColor=#D6A31C;strokeWidth=2;fontSize=15;fontColor=#9A7412;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" vertex="1" parent="1"><mxGeometry x="980" y="170" width="200" height="82" as="geometry"/></mxCell>
