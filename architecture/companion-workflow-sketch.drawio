        <mxCell id="y3" value="The judge is the exception.&#10;Run it hosted: a few hundred calls for the whole project, and a weak judge grading a weak model tells you nothing." style="text;html=1;whiteSpace=wrap;align=left;fontSize=13;fontColor=#B32219;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" vertex="1" parent="1"><mxGeometry x="980" y="366" width="200" height="106" as="geometry"/></mxCell>

