<mxfile host="app.diagrams.net" version="24.7.17" type="device">

  <diagram name="1 · FTI architecture" id="fti">
    <mxGraphModel dx="1500" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="rule" value="THE FTI RULE — pipelines never call each other. They communicate ONLY through the feature store and the model registry.&#10;That is why Capstone 1 can finish in four weeks and Capstone 2 can start months later without a rewrite: the interface is two artifacts, not an API contract between teams." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="28" y="20" width="1180" height="40" as="geometry"/></mxCell>

        <mxCell id="laneA" value="LANE A — THE SITUATION ROUTER   ·   a trained model, so it has all three pipelines" style="text;html=1;align=left;fontSize=11;fontColor=#0D6A60" vertex="1" parent="1"><mxGeometry x="28" y="78" width="600" height="18" as="geometry"/></mxCell>
        <mxCell id="laneB" value="LANE B — THE CARD CORPUS   ·   retrieval only, so the training pipeline is empty" style="text;html=1;align=left;fontSize=11;fontColor=#59645F" vertex="1" parent="1"><mxGeometry x="700" y="78" width="600" height="18" as="geometry"/></mxCell>

        <mxCell id="rowF" value="FEATURE PIPELINE" style="text;html=1;align=left;fontSize=9.5;fontColor=#59645F" vertex="1" parent="1"><mxGeometry x="28" y="106" width="300" height="14" as="geometry"/></mxCell>
        <mxCell id="fa" value="Build the labelled corpus&#10;public seed → synthetic generation → hand-labelled real test set&#10;annotation guidelines · Cohen kappa · train/val/test split" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="28" y="126" width="600" height="84" as="geometry"/></mxCell>
        <mxCell id="fb" value="Ingest the provider material&#10;upload → parse → chunk → embed&#10;runs per tenant, on upload and nightly" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="700" y="126" width="430" height="84" as="geometry"/></mxCell>

        <mxCell id="rowFS" value="FEATURE STORE — one postgres, two shapes of feature" style="text;html=1;align=left;fontSize=9.5;fontColor=#59645F" vertex="1" parent="1"><mxGeometry x="28" y="282" width="600" height="14" as="geometry"/></mxCell>
        <mxCell id="fsa" value="postgres · labelled corpus tables&#10;message text, label, annotator, split, corpus version (DVC)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="28" y="302" width="600" height="72" as="geometry"/></mxCell>
        <mxCell id="fsb" value="pgvector · card_chunks&#10;chunk text + embedding(768) + tenant_id on the row itself" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="700" y="302" width="430" height="72" as="geometry"/></mxCell>

        <mxCell id="rowT" value="TRAINING PIPELINE" style="text;html=1;align=left;fontSize=9.5;fontColor=#59645F" vertex="1" parent="1"><mxGeometry x="28" y="446" width="300" height="14" as="geometry"/></mxCell>
        <mxCell id="ta" value="Train and compare&#10;0 majority · 1 TF-IDF + LogReg (the baseline) · 2 SVM / GBM · 3 fine-tuned XLM-R · 4 LLM zero-shot&#10;scored on the FROZEN real test set.  macro-F1 + per-class recall." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="28" y="466" width="600" height="84" as="geometry"/></mxCell>
        <mxCell id="tb2" value="NO TRAINING PIPELINE&#10;There is nothing to fit. The presenter is an API call to a model someone else trained." style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#9A9A9A;strokeWidth=2;dashed=1;fontSize=11;fontColor=#59645F" vertex="1" parent="1"><mxGeometry x="700" y="466" width="430" height="84" as="geometry"/></mxCell>
        <mxCell id="tnote" value="THIS EMPTY BOX IS THE WHOLE CAPSTONE 1 PROBLEM.&#10;A RAG build lives entirely in lane B, where there is no baseline to beat and no&#10;models to compare. Lane A is the only place the Data Scientist certificate can be earned." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#A34D26" vertex="1" parent="1"><mxGeometry x="700" y="562" width="430" height="50" as="geometry"/></mxCell>

        <mxCell id="rowMR" value="MODEL REGISTRY — the second interface" style="text;html=1;align=left;fontSize=9.5;fontColor=#59645F" vertex="1" parent="1"><mxGeometry x="28" y="622" width="300" height="14" as="geometry"/></mxCell>
        <mxCell id="mra" value="MLflow registry&#10;alias &quot;champion&quot; is the only thing inference knows about.&#10;Promotion is a deliberate human act, never automatic." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;dashed=1;dashPattern=6 4;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="28" y="642" width="600" height="76" as="geometry"/></mxCell>
        <mxCell id="mrb" value="nothing to register&#10;the presenter model is pinned by version string in config" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#9A9A9A;dashed=1;fontSize=11;fontColor=#59645F" vertex="1" parent="1"><mxGeometry x="700" y="642" width="430" height="76" as="geometry"/></mxCell>

        <mxCell id="rowI" value="INFERENCE PIPELINE — reads both interfaces" style="text;html=1;align=left;fontSize=9.5;fontColor=#59645F" vertex="1" parent="1"><mxGeometry x="28" y="788" width="600" height="14" as="geometry"/></mxCell>
        <mxCell id="inf" value="the api  ·  FastAPI in Docker&#10;&#10;ingress guardrails (PII redaction → injection → CRISIS)  →  router.predict()  →  retrieve top-k, tenant-filtered  →  presenter  →  groundedness gate  →  refusal policy  →  deliver on the same channel" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=3;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="28" y="808" width="1102" height="86" as="geometry"/></mxCell>

        <mxCell id="a1" value="write features" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="fa" target="fsa"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="read features" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="fsa" target="ta"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="register the winner" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="ta" target="mra"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" value="load &quot;champion&quot; at startup" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.45;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="mra" target="inf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a5" value="write chunks" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#161D1A;strokeWidth=2;fontSize=10;fontColor=#161D1A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="fb" target="fsb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a6" value="similarity search, tenant-filtered" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#161D1A;strokeWidth=2;fontSize=10;fontColor=#161D1A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="fsb" target="inf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="338"/><mxPoint x="1190" y="780"/></Array></mxGeometry></mxCell>

        <mxCell id="n1" value="1" style="ellipse;html=1;fillColor=#0D6A60;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-8" y="156" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="n2" value="2" style="ellipse;html=1;fillColor=#0D6A60;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-8" y="326" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="n3" value="3" style="ellipse;html=1;fillColor=#0D6A60;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-8" y="496" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="n4" value="4" style="ellipse;html=1;fillColor=#0D6A60;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-8" y="668" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="n5" value="5" style="ellipse;html=1;fillColor=#161D1A;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1" vertex="1" parent="1"><mxGeometry x="-8" y="839" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="n6" value="6" style="ellipse;html=1;fillColor=#161D1A;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1142" y="156" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="n7" value="7" style="ellipse;html=1;fillColor=#161D1A;strokeColor=none;fontColor=#FFFFFF;fontSize=11;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1142" y="326" width="24" height="24" as="geometry"/></mxCell>

        <mxCell id="lg1" value="" style="rounded=0;html=1;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;dashed=1;dashPattern=6 4" vertex="1" parent="1"><mxGeometry x="28" y="928" width="34" height="18" as="geometry"/></mxCell>
        <mxCell id="lg1t" value="CAPSTONE 1  ·  steps 1 to 4, lane A only.  Four weeks from 21.09.  Needs no client, which is the point." style="text;html=1;align=left;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="72" y="926" width="600" height="20" as="geometry"/></mxCell>
        <mxCell id="lg2" value="" style="rounded=0;html=1;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=3" vertex="1" parent="1"><mxGeometry x="28" y="958" width="34" height="18" as="geometry"/></mxCell>
        <mxCell id="lg2t" value="CAPSTONE 2  ·  steps 5 to 8 plus CI/CD and monitoring.  Lane B needs provider material, so it needs G4 to resolve first." style="text;html=1;align=left;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="72" y="956" width="700" height="20" as="geometry"/></mxCell>
        <mxCell id="lg3t" value="Pattern after Paul Iusztin&apos;s FTI architecture (Decoding ML). His version splits ONE model&apos;s pipeline in three;&#10;this splits two lanes, because a retrieval lane and a trained-model lane sit in the same product and only one has a training pipeline." style="text;html=1;whiteSpace=wrap;align=left;fontSize=10;fontColor=#59645F" vertex="1" parent="1"><mxGeometry x="790" y="924" width="510" height="56" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2 · Deployment topology" id="deploy">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="960" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="ti" value="Capstone 2 — the production topology" style="text;html=1;align=left;fontSize=22;fontStyle=1;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="40" y="24" width="700" height="28" as="geometry"/></mxCell>
        <mxCell id="su" value="Capstone 1 ships only the blue boxes: api + postgres. Everything teal is added here. Nothing inside is reachable from the internet except the tunnel." style="text;html=1;align=left;fontSize=12;fontColor=#59645F" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1000" height="20" as="geometry"/></mxCell>

        <mxCell id="tb" value="TRUST BOUNDARY — docker compose on one small VM" style="rounded=0;html=1;fillColor=none;strokeColor=#161D1A;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=10;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="380" y="120" width="640" height="740" as="geometry"/></mxCell>

        <mxCell id="x1" value="Telegram servers" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=12;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="40" y="160" width="220" height="56" as="geometry"/></mxCell>
        <mxCell id="x2" value="Family / hire browser" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=12;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="40" y="252" width="220" height="56" as="geometry"/></mxCell>
        <mxCell id="x3" value="Provider staff browser&#10;dashboard + consultant queue" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=12;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="40" y="344" width="220" height="56" as="geometry"/></mxCell>

        <mxCell id="tun" value="cloudflared tunnel&#10;Telegram only calls a public HTTPS endpoint" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=12;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="400" y="156" width="600" height="56" as="geometry"/></mxCell>
        <mxCell id="api" value="api  ·  FastAPI + uvicorn  :8000&#10;routers · Pydantic · guardrails in and out" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E1ECFB;strokeColor=#2E6FD9;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="400" y="264" width="370" height="76" as="geometry"/></mxCell>
        <mxCell id="wrk" value="worker&#10;Prefect flows&#10;spine · ingestion · nightly" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=12;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="800" y="264" width="200" height="76" as="geometry"/></mxCell>
        <mxCell id="pg" value="postgres  :5432  +  pgvector&#10;relational rows AND embeddings in one store.  tenant_id on every request-reachable table, row-level security." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E1ECFB;strokeColor=#2E6FD9;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="400" y="396" width="600" height="72" as="geometry"/></mxCell>
        <mxCell id="mlf" value="mlflow  :5000&#10;tracking + registry" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=12;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="400" y="514" width="285" height="70" as="geometry"/></mxCell>
        <mxCell id="trn" value="trainer&#10;DVC pull → fit → eval → log" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=12;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="715" y="514" width="285" height="70" as="geometry"/></mxCell>
        <mxCell id="prom" value="prometheus  :9090&#10;golden signals" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=12;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="400" y="620" width="285" height="66" as="geometry"/></mxCell>
        <mxCell id="graf" value="grafana  :3000&#10;one dashboard, one alert" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=12;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="715" y="620" width="285" height="66" as="geometry"/></mxCell>
        <mxCell id="evi" value="evidently report job&#10;nightly: input drift on check-in text, prediction distribution over time" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=12;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="400" y="722" width="600" height="62" as="geometry"/></mxCell>
        <mxCell id="nv" value="NOT in v1, on purpose: no Redis, no Celery, no Kafka, no separate model server, no Kubernetes.&#10;Add a broker when you can name the queue that is actually backing up." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#A34D26" vertex="1" parent="1"><mxGeometry x="400" y="800" width="600" height="40" as="geometry"/></mxCell>

        <mxCell id="llm" value="LLM API&#10;OUTSIDE the boundary" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F2DFD5;strokeColor=#A34D26;strokeWidth=2.5;fontSize=12;fontStyle=1;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="1080" y="252" width="210" height="62" as="geometry"/></mxCell>
        <mxCell id="lfz" value="Langfuse&#10;traces, eval runs" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=12;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="1080" y="396" width="210" height="60" as="geometry"/></mxCell>
        <mxCell id="ghcr" value="GHCR&#10;container images" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=12;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="1080" y="620" width="210" height="60" as="geometry"/></mxCell>

        <mxCell id="e1" value="HTTPS webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#161D1A;strokeWidth=1.5;fontSize=10;fontColor=#161D1A;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0" edge="1" parent="1" source="x1" target="tun"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#161D1A;strokeWidth=1.5;fontSize=10;fontColor=#161D1A;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.08;entryY=1;entryDx=0;entryDy=0" edge="1" parent="1" source="x2" target="tun"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="HTTPS /admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#161D1A;strokeWidth=1.5;fontSize=10;fontColor=#161D1A;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.04;entryY=1;entryDx=0;entryDy=0" edge="1" parent="1" source="x3" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="HTTP :8000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#161D1A;strokeWidth=1.5;fontSize=10;fontColor=#161D1A;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="tun" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="SQL · tenant_id on every query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E6FD9;strokeWidth=2;fontSize=10;fontColor=#2E6FD9;labelBackgroundColor=#FFFFFF;exitX=0.12;exitY=1;exitDx=0;exitDy=0;entryX=0.12;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="api" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.92;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="wrk" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="/internal/dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="wrk" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="HTTPS — ONLY after PII redaction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A34D26;strokeWidth=2.5;fontSize=10;fontColor=#A34D26;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="api" target="llm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="678" y="238"/><mxPoint x="1046" y="238"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="traces — no raw message text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#161D1A;strokeWidth=1.5;fontSize=10;fontColor=#161D1A;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;exitX=0.92;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="api" target="lfz"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="372"/><mxPoint x="1042" y="372"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="log runs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="trn" target="mlf"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="read corpus" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.62;entryY=1;entryDx=0;entryDy=0" edge="1" parent="1" source="trn" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="scrape /metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0" edge="1" parent="1" source="prom" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="392" y="653"/><mxPoint x="392" y="329"/></Array></mxGeometry></mxCell>
        <mxCell id="e13" value="PromQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="graf" target="prom"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="read check-ins" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0" edge="1" parent="1" source="evi" target="pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1008" y="753"/><mxPoint x="1008" y="450"/></Array></mxGeometry></mxCell>
        <mxCell id="e15" value="docker pull" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#59645F;dashed=1;fontSize=10;fontColor=#59645F;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.78;entryDx=0;entryDy=0" edge="1" parent="1" source="ghcr" target="tb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="nt" value="The api resolves the MLflow &quot;champion&quot; alias at startup. That is the only coupling between the model path and the request path." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#0D6A60" vertex="1" parent="1"><mxGeometry x="1060" y="490" width="250" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3 · CI/CD + MLOps loop" id="cicd">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="h1" value="CODE PATH — every push" style="text;html=1;align=left;fontSize=11;fontColor=#59645F" vertex="1" parent="1"><mxGeometry x="50" y="30" width="300" height="20" as="geometry"/></mxCell>

        <mxCell id="push" value="git push&#10;pre-commit already ran ruff + black locally" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="50" y="60" width="180" height="70" as="geometry"/></mxCell>

        <mxCell id="gha" value="GitHub Actions" style="rounded=0;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#161D1A;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="280" y="45" width="620" height="270" as="geometry"/></mxCell>
        <mxCell id="j1" value="lint&#10;ruff · black --check · mypy" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=10;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="300" y="85" width="180" height="52" as="geometry"/></mxCell>
        <mxCell id="j2" value="pytest unit&#10;guardrails, routing, schemas" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=10;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="500" y="85" width="180" height="52" as="geometry"/></mxCell>
        <mxCell id="j3" value="pytest integration&#10;spins postgres + pgvector in a service container" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=10;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="700" y="85" width="180" height="52" as="geometry"/></mxCell>
        <mxCell id="j4" value="data validation&#10;schema + label set + no-PII assertion on the corpus" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=10;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="300" y="160" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="j5" value="TENANT ISOLATION TEST&#10;a cross-tenant SELECT must return zero rows" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2DFD5;strokeColor=#A34D26;strokeWidth=2;fontSize=10;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="500" y="160" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="j6" value="MODEL QUALITY GATE&#10;score the registry champion on the frozen real test set.&#10;Fail the build if macro-F1 drops, or if recall on &quot;considering leaving&quot; drops at all." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="700" y="160" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="j7" value="docker build → push to GHCR&#10;only if every job above is green" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=10;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="300" y="245" width="580" height="50" as="geometry"/></mxCell>

        <mxCell id="dep" value="deploy&#10;docker compose pull + up.&#10;Public deploy optional per the brief." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="950" y="230" width="200" height="80" as="geometry"/></mxCell>

        <mxCell id="h2" value="MODEL PATH — on demand, manual trigger is enough for now" style="text;html=1;align=left;fontSize=11;fontColor=#59645F" vertex="1" parent="1"><mxGeometry x="50" y="380" width="400" height="20" as="geometry"/></mxCell>

        <mxCell id="dvc" value="DVC remote&#10;versioned corpus + trained artifacts.&#10;The git repo holds pointers, never the data." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="50" y="410" width="200" height="86" as="geometry"/></mxCell>
        <mxCell id="tr2" value="trainer flow&#10;split → fit → eval on the FROZEN real test set&#10;models 0 to 4 in one run" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="310" y="410" width="220" height="86" as="geometry"/></mxCell>
        <mxCell id="mt" value="MLflow tracking&#10;one run per model, params + macro-F1 + per-class recall + confusion matrix" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="590" y="410" width="220" height="86" as="geometry"/></mxCell>
        <mxCell id="mr" value="MLflow registry&#10;alias &quot;champion&quot; = what the api loads&#10;promotion is a deliberate human act" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="870" y="410" width="220" height="86" as="geometry"/></mxCell>

        <mxCell id="rt" value="RETRAIN TRIGGER&#10;manual for now. Two signals should prompt it:&#10;Evidently reports input drift on check-in text, or the confusion matrix shows a new situation the taxonomy has no class for." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#F2DFD5;strokeColor=#A34D26;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="50" y="570" width="480" height="90" as="geometry"/></mxCell>

        <mxCell id="warn" value="THE GATE IS THE POINT&#10;&#10;A model-quality gate that only checks macro-F1 will happily ship a model that got better on average&#10;by getting worse at spotting someone who is about to go home. That is why the gate has a second,&#10;stricter condition on one class. Write that test in week 3, while you still have the confusion matrix open." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;strokeColor=#0D6A60;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="570" y="570" width="580" height="90" as="geometry"/></mxCell>

        <mxCell id="y1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#161D1A;fontSize=10" edge="1" parent="1" source="push" target="gha"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="y2" value="all green" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=none" edge="1" parent="1" source="j7" target="dep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="y3" value="dvc pull" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=none" edge="1" parent="1" source="dvc" target="tr2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="y4" value="log" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=none" edge="1" parent="1" source="tr2" target="mt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="y5" value="register the winner" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0D6A60;strokeWidth=2;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=none" edge="1" parent="1" source="mt" target="mr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="y6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0D6A60;strokeWidth=2;dashed=1;fontSize=10;fontColor=#0D6A60;labelBackgroundColor=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="mr" target="j6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="y7" value="triggers" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#A34D26;strokeWidth=2;fontSize=10;fontColor=#A34D26;labelBackgroundColor=none" edge="1" parent="1" source="rt" target="tr2"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="4 · Data model + isolation" id="datamodel">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="dh" value="PostgreSQL.  Every table a request can reach carries tenant_id, and a row-level security policy binds it to the caller.&#10;That is the whole white-label promise, expressed as a column rather than as a convention." style="text;html=1;whiteSpace=wrap;align=left;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="50" y="30" width="900" height="40" as="geometry"/></mxCell>

        <mxCell id="t1" value="tenants&#10;&#10;id  PK&#10;name&#10;brand_assets&#10;default_locale&#10;dpa_signed_at" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="50" y="100" width="180" height="130" as="geometry"/></mxCell>

        <mxCell id="t2" value="seats&#10;&#10;id  PK&#10;tenant_id  FK&#10;kind  family | hire&#10;enrolled_at&#10;journey_template&#10;review_date  NULL for families" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="290" y="100" width="200" height="130" as="geometry"/></mxCell>

        <mxCell id="t3" value="people&#10;&#10;id  PK&#10;seat_id  FK&#10;tenant_id  FK&#10;role  partner | employee | child | manager&#10;language&#10;&#10;THE ONLY TABLE WITH REAL PII" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F2DFD5;strokeColor=#A34D26;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="550" y="100" width="220" height="150" as="geometry"/></mxCell>

        <mxCell id="t4" value="messages&#10;&#10;id  PK&#10;seat_id  FK&#10;tenant_id  FK&#10;direction  in | out&#10;channel  telegram | web&#10;body_redacted   ← redacted BEFORE insert&#10;created_at" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="50" y="300" width="230" height="150" as="geometry"/></mxCell>

        <mxCell id="t5" value="situations&#10;&#10;id  PK&#10;message_id  FK&#10;tenant_id  FK&#10;label&#10;confidence&#10;model_version   ← ties a prediction to an MLflow run" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#D6E8E5;strokeColor=#0D6A60;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="340" y="300" width="230" height="150" as="geometry"/></mxCell>

        <mxCell id="t6" value="cards&#10;&#10;id  PK&#10;tenant_id  NULL = your global corpus&#10;corridor · role · window_position&#10;body&#10;version&#10;author  you | the provider" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="630" y="300" width="240" height="150" as="geometry"/></mxCell>

        <mxCell id="t7" value="card_chunks&#10;&#10;id  PK&#10;card_id  FK&#10;tenant_id  FK   ← denormalised ON PURPOSE&#10;chunk_text&#10;embedding   vector(768)&#10;&#10;pgvector index, and every similarity query&#10;is filtered on tenant_id first" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F2DFD5;strokeColor=#A34D26;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="630" y="500" width="240" height="170" as="geometry"/></mxCell>

        <mxCell id="t8" value="flags&#10;&#10;id  PK&#10;seat_id  FK&#10;tenant_id  FK&#10;kind  crisis | no_match | risk&#10;raised_at&#10;claimed_by · claimed_at   ← the SLA lives here" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#F2DFD5;strokeColor=#A34D26;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="50" y="500" width="250" height="150" as="geometry"/></mxCell>

        <mxCell id="t9" value="dispatches&#10;&#10;id  PK&#10;seat_id  FK&#10;card_id  FK&#10;tenant_id  FK&#10;channel · sent_at&#10;grounded  bool   ← did it cite a chunk&#10;trigger  spine | checkin | pull" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#DEE4DE;strokeColor=#161D1A;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="340" y="500" width="250" height="150" as="geometry"/></mxCell>

        <mxCell id="rls" value="THE ISOLATION TEST, and why tenant_id is denormalised onto card_chunks&#10;&#10;A similarity search is the one query that does not naturally join back to a tenant. If tenant_id lives only on cards, then&#10;a vector query has to remember to join, and the day someone forgets, one provider's material surfaces inside another&#10;provider's family conversation. Carrying the column on the chunk row makes the filter unforgettable and makes the&#10;guarantee testable: insert two tenants, embed both, query as tenant A, assert zero rows from tenant B.&#10;That test belongs in CI (page 2), not in a checklist." style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=none;strokeColor=#A34D26;strokeWidth=2;fontSize=11;fontColor=#161D1A" vertex="1" parent="1"><mxGeometry x="50" y="700" width="820" height="125" as="geometry"/></mxCell>

        <mxCell id="z1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#161D1A" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#161D1A" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#161D1A" edge="1" parent="1" source="t2" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#161D1A" edge="1" parent="1" source="t4" target="t5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#161D1A" edge="1" parent="1" source="t6" target="t7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#161D1A" edge="1" parent="1" source="t2" target="t8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#161D1A" edge="1" parent="1" source="t2" target="t9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="z8" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#161D1A;fontSize=10;fontColor=#161D1A;labelBackgroundColor=none" edge="1" parent="1" source="t6" target="t9"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
